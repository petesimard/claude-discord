# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API Key
# Required by Claude Agent SDK
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Channel Mappings (REQUIRED)
# Map Discord channels to their settings including working directory
# Format: JSON object with channel IDs as keys and settings objects as values
#
# Settings per channel:
#   - path (required): Working directory for this channel (main Git repository)
#   - autoUpdate (optional): Auto git pull before new conversations (default: false)
#   - forumChannelId (optional): Forum channel ID to create session threads in
#   - workTreeBase (optional): Base directory for creating Git worktrees (default: none, use main repo)
#   - branchUrl (optional): URL template for branch links, use [branchId] as placeholder
#                          Example: "https://[branchId].example.com" or "https://preview.example.com/[branchId]"
#
# ⚠️  IMPORTANT: All Discord IDs MUST be strings (in quotes) to prevent truncation!
#    ✅ Correct: "forumChannelId":"1234567890123456789"
#    ❌ Wrong:   "forumChannelId":1234567890123456789
#
# Examples:
#   Single channel:
#     {"1234567890":{"path":"/path/to/project"}}
#
#   With branch URL for preview deployments:
#     {"1234567890":{"path":"/path/to/project","workTreeBase":"../","branchUrl":"https://[branchId].preview.mysite.com"}}
#
#   Multiple channels with auto-update, forum, and worktrees (note quotes around IDs):
#     {"1234567890":{"path":"/project1","autoUpdate":true,"forumChannelId":"1111111111","workTreeBase":"../"},"9876543210":{"path":"/project2","autoUpdate":false}}
#
#   With worktrees enabled, each new conversation creates a separate Git worktree, allowing
#   parallel work without conflicts. Set workTreeBase to "../" to create worktrees in the
#   parent directory of your project, or specify an absolute path like "/tmp/worktrees".
#   Worktrees are named "<repo-folder-name>-<session-id>" (e.g., "my-project-abc123").
#
# To get a channel ID: Enable Developer Mode in Discord, right-click a channel, and select "Copy ID"
CHANNEL_MAPPINGS={"CHANNELID":{"path":"/path/to/project"}}

# Debug Mode (optional)
# Set to 1 to enable verbose debugging output from Claude Agent SDK
# This will show detailed error messages from the Claude CLI subprocess
DEBUG=
