# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API Key
# Required by Claude Agent SDK
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Channel Mappings (REQUIRED)
# Map Discord channels to their settings including working directory
# Format: JSON object with channel IDs as keys and settings objects as values
#
# Settings per channel:
#   - path (required): Working directory for this channel
#   - autoUpdate (optional): Auto git pull or svn update before new conversations (default: false)
#
# Examples:
#   Single channel:
#     {"1234567890":{"path":"/path/to/project"}}
#
#   Multiple channels with auto-update:
#     {"1234567890":{"path":"/project1","autoUpdate":true},"9876543210":{"path":"/project2","autoUpdate":false}}
#
# To get a channel ID: Enable Developer Mode in Discord, right-click a channel, and select "Copy ID"
CHANNEL_MAPPINGS={"CHANNELID":{"path":"/path/to/project"}}

# Debug Mode (optional)
# Set to 1 to enable verbose debugging output from Claude Agent SDK
# This will show detailed error messages from the Claude CLI subprocess
DEBUG=
