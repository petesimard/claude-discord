# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Working directory for Claude Code agent (default)
# This is where the agent will execute commands and access files
# Used as the default if no channel-specific mapping is found
WORKING_DIR=/path/to/your/working/directory

# Anthropic API Key
# Required by Claude Agent SDK
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Channel to Working Directory Mappings (optional)
# Map specific Discord channels to different working directories
# Format: JSON object with channel IDs as keys and paths as values
# Example: {"1234567890123456789":"/path/to/project1","9876543210987654321":"/path/to/project2"}
# When set, the bot will ONLY respond in the mapped channels
# Leave empty to use WORKING_DIR for all channels
CHANNEL_MAPPINGS=

# Allowed Channel ID (optional - only used if CHANNEL_MAPPINGS is not set)
# If set, the bot will only respond to commands from this specific channel
# Note: This is ignored if CHANNEL_MAPPINGS is configured (use mappings instead)
# Leave empty or comment out to allow all channels
# To get a channel ID: Enable Developer Mode in Discord, right-click a channel, and select "Copy ID"
ALLOWED_CHANNEL_ID=
